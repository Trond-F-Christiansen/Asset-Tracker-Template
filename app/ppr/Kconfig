config PPR_HELLO
	bool "Enable periodic PPR hello world messages"
	default y
	help
	  Enable periodic "hello world" log messages from the PPR core.

if PPR_HELLO

config PPR_HELLO_INTERVAL_SECONDS
	int "Hello world interval (seconds)"
	default 60
	help
	  Interval between the "hello world" log messages printed by the PPR core.

endif # PPR_HELLO

source "Kconfig.zephyr"
