choice BOOTLOADER
	default BOOTLOADER_MCUBOOT if !BOARD_NATIVE_SIM
endchoice

config NCS_MCUBOOT_LOAD_PERIPHCONF
	default y if BOARD_NRF9251DK_NRF9251_CPUAPP

config SECURE_BOOT_APPCORE
	default y if BOARD_NRF9151DK_NRF9151_NS

# Merge the hex files as a single file for easier flashing with external tools.
config MERGED_HEX_FILES
	default y

config ATT_MERGED_HEX_PAD
	bool "Pad merged hex files to 16-byte MRAM lines"
	depends on MERGED_HEX_FILES
	default y if SOC_SERIES_NRF92
	help
	  Pad every segment of the merged_<board_target>.hex files with 0xFF to
	  a 16-byte boundary (scripts/pad_hex.py). Needed to program nRF92 MRAM
	  with J-Link using the generic CORTEX-M33 device, which otherwise loses
	  the bytes of a partial last line and aborts the download. nrfutil does
	  not need it.

# Shared NSIB (b0) signing key for all ATT sysbuild targets. Sysbuild signs images with this
# key; b0 verifies them. Without this, sysbuild autogenerates a new debug key on each pristine
# build. Not for production.
config SECURE_BOOT_SIGNING_KEY_FILE
	default "$(ZEPHYR_NRF_MODULE_DIR)/boards/nordic/thingy91x/nsib_signing_key.pem"

config WIFI_NRF70
	default y if BOARD_THINGY91X_NRF9151_NS

choice WIFI_NRF70_OPER_MODES
	default WIFI_NRF70_SCAN_ONLY if BOARD_THINGY91X_NRF9151_NS
endchoice

config LAUNCH_PPR
	bool "Launch the PPR core and forward its logs to the application core over IPC"
	depends on SUPPORT_PPRCORE
	help
	  Builds app/ppr as the PPR core image, launches it from the application
	  core, and forwards its log output over IPC (icmsg-me) to the application
	  core's log backends.

if SUPPORT_PPRCORE

choice PPRCORE
	default PPRCORE_REMOTE if LAUNCH_PPR

config PPRCORE_REMOTE
	bool "ATT PPR image"
	depends on LAUNCH_PPR

endchoice

config PPRCORE_IMAGE_NAME
	default "ppr" if PPRCORE_REMOTE

config PPRCORE_IMAGE_PATH
	default "$(APP_DIR)/ppr" if PPRCORE_REMOTE

endif # SUPPORT_PPRCORE

config ATT_PWM_ON_PPR
	bool "Run the PWM module on the PPR core"
	depends on LAUNCH_PPR
	help
	  Run the PWM module implementation (pwm130 on P2.2) on the PPR core instead of the
	  application core. pwm_chan is forwarded to the PPR core with the zbus proxy agent. The
	  att_pwm shell commands always run on the application core. Cannot be combined with
	  ATT_SAADC_ON_PPR, both together do not fit in the PPR RAM.

config ATT_SAADC_ON_PPR
	bool "Run the SAADC module on the PPR core"
	depends on LAUNCH_PPR
	help
	  Run the SAADC module implementation on the PPR core instead of the application core.
	  saadc_chan is forwarded to the PPR core and saadc_resp_chan back to the application core
	  with the zbus proxy agent. The att_saadc shell commands always run on the application
	  core. Cannot be combined with ATT_PWM_ON_PPR, both together do not fit in the PPR RAM.

source "${ZEPHYR_BASE}/share/sysbuild/Kconfig"

if BOARD_NRF9251DK_NRF9251_CPUAPP

config SUPPORT_PPRCORE
	default y

config PPRCORE_REMOTE_BOARD_TARGET_CPUCLUSTER
	default "cpuppr"

config SUPPORT_PPRCORE_REMOTE
	bool
	default y

endif # BOARD_NRF9251DK_NRF9251_CPUAPP
