menu "PPR launcher"

config APP_PPR_LAUNCHER
	bool "Manual PPR launcher with shell control"
	depends on SOC_SERIES_NRF92
	depends on SHELL
	help
	  Replicate the load + cache-flush + cpurun_set sequence done by
	  drivers/misc/nordic_vpr_launcher, but expose it behind shell
	  commands `ppr start` / `ppr stop` / `ppr status` so the PPR can be
	  brought up at a chosen moment (e.g. after nrf_modem_lib_init()).

	  Add overlay-ppr-manual.overlay via EXTRA_DTC_OVERLAY_FILE (see overlay file header).
	  Do not set DTC_OVERLAY_FILE to this file only, or boards/<BOARD>.overlay is skipped
	  and the nRF9251 MRAM child node (mram_memory_0) is missing from the merged DTS.
	  It removes execution-memory and source-memory from &cpuppr_vpr so
	  CONFIG_NORDIC_VPR_LAUNCHER is disabled; otherwise the board DTS still supplies
	  those phandles and the PPR starts at POST_KERNEL before your shell runs.

if APP_PPR_LAUNCHER

config APP_PPR_LAUNCHER_LOG_LEVEL
	int "PPR launcher log level"
	default 4
	range 0 4

endif # APP_PPR_LAUNCHER

endmenu
