menuconfig APP_POWER_MONITOR
	bool "Power monitor module (INA228/INA238)"
	depends on DT_HAS_TI_INA228_ENABLED || DT_HAS_TI_INA237_ENABLED
	select SENSOR
	default y
	help
	  Reads a TI INA228 or INA238 power monitor (devicetree node label
	  "sip_power_monitor") on demand using the Zephyr sensor driver. The INA238 has no
	  Zephyr compatible of its own and is described as "ti,ina237", see
	  boards/ina238.overlay. Reports voltage, current and power. With an INA228, energy and
	  charge are also integrated by the hardware accumulators between readouts, and energy
	  and average current are reported through logs, shell commands and Memfault metrics.

if APP_POWER_MONITOR

config APP_POWER_MONITOR_ACCUMULATORS
	bool
	default y if DT_HAS_TI_INA228_ENABLED
	help
	  The power monitor has energy and charge accumulators (INA228). Not available on the
	  INA238.

config APP_POWER_MONITOR_MAX_READ_INTERVAL_HOURS
	int "Maximum time between readouts"
	default 10
	range 0 240
	depends on APP_POWER_MONITOR_ACCUMULATORS
	help
	  The INA228 is read when data is needed (shell command, Memfault heartbeat). If
	  nothing has read it for this many hours, a safety readout is done on the system
	  workqueue so that the hardware charge accumulator cannot overflow. With a 1 uA
	  current LSB it overflows after about 550000 C: about 11 days at the 546 mA full
	  scale of a 300 mOhm shunt. Set to 0 to disable the safety readout.

config APP_POWER_MONITOR_LOG_SAMPLES
	bool "Log every readout"
	default n
	help
	  Log voltage, current and power at every readout, and the average current since the
	  previous readout if the power monitor has accumulators.

config APP_POWER_MONITOR_SHELL
	bool "Power monitor shell commands"
	depends on SHELL
	default y

module = APP_POWER_MONITOR
module-str = Power monitor
source "subsys/logging/Kconfig.template.log_config"

endif # APP_POWER_MONITOR
