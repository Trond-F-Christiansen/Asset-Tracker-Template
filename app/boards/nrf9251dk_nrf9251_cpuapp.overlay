#include "nrf9251dk_common.overlay"

/* Used for hardware fallback by task watchdog. */
&wdt010 {
	status = "okay";
};

/* Built-in Wi-Fi, used for Wi-Fi location. */
&cpuapp_wifi {
	status = "okay";
};

/* Carve the Memfault coredump partition out of the application slots. Must match
 * app/sysbuild/mcuboot/boards/nrf9251dk_nrf9251_cpuapp.overlay.
 */
&mram1x {
	partitions {
		cpuapp_slot0_partition: partition@322000 {
			compatible = "zephyr,mapped-partition";
			reg = <0x322000 DT_SIZE_K(588)>;
		};

		memfault_coredump_partition: partition@3b5000 {
			compatible = "zephyr,mapped-partition";
			reg = <0x3b5000 DT_SIZE_K(64)>;
		};

		cpuapp_slot1_partition: partition@40a000 {
			compatible = "zephyr,mapped-partition";
			reg = <0x40a000 DT_SIZE_K(588)>;
		};
	};
};

/* External flash (32 MiB). fmfu_storage_partition is reserved for full modem FOTA.
 *
 * The flash is not fitted on every board, and the SPI NOR driver waits forever for it during
 * device init when it does not answer, which hangs the application before main(). Everything
 * it needs is therefore disabled here. On a board with the flash fitted, enable it from an
 * overlay (for example -DEXTRA_DTC_OVERLAY_FILE=...):
 *
 *	&dma_fast_region { status = "okay"; };
 *	&gpio5 { status = "okay"; };
 *	&spi120 { status = "okay"; };
 *	&flash_ext { status = "okay"; };
 *
 * Full modem FOTA and its stream flash erase follow the status of flash_ext, see app/Kconfig.
 */
&dma_fast_region {
	status = "okay";
};

&gpio5 {
	status = "okay";
};

&spi120 {
	status = "okay";
};

flash_ext: &gd25le255e {
	status = "okay";

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		fmfu_storage_partition: partition@0 {
			label = "fmfu_storage";
			reg = <0x00000000 0x00400000>;
		};

		littlefs_storage: partition@400000 {
			label = "littlefs_storage";
			reg = <0x00400000 0x00100000>;
		};

		external_flash_partition: partition@500000 {
			label = "external_flash";
			reg = <0x00500000 0x01b00000>;
		};
	};
};

/ {
	chosen {
		nordic,fmfu-storage-partition = &fmfu_storage_partition;
	};

	fstab {
		compatible = "zephyr,fstab";
		lfs1: lfs1 {
			compatible = "zephyr,fstab,littlefs";
			mount-point = "/att_storage";
			partition = <&littlefs_storage>;
			automount;
			read-size = <16>;
			prog-size = <16>;
			cache-size = <64>;
			lookahead-size = <32>;
			block-cycles = <512>;
		};
	};
};
/* Application-core die temperature via the nRFS temperature service. */
&temp_nrfs {
	status = "okay";
};

/* PWM and SAADC modules. The zephyr,user node is shared with the PPR image, which gets the
 * equivalent nodes from the ppr.overlay in the remote folder of each module
 * (src/modules/pwm and src/modules/saadc) when a module is placed on the PPR core
 * (SB_CONFIG_ATT_PWM_ON_PPR, SB_CONFIG_ATT_SAADC_ON_PPR). In that case pwm130 and the SAADC are
 * disabled for this image by the app.overlay in the same folders.
 */
/ {
	zephyr,user {
		/* P2.2, the same pin as led0 */
		pwms = <&pwm130 0 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		io-channels = <&adc 0>;
	};
};

&adc {
	#address-cells = <1>;
	#size-cells = <0>;

	/* Sample AIN1 (P1.1). The nRF92 SAADC has no internal inputs, only pins. */
	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_2";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN1>;
		zephyr,resolution = <12>;
	};
};
